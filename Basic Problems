import java.util.Scanner;
import java.util.HashMap;
class Solution {
    public int kDistinctChar(String s, int k) {
        int n = s.length();
        int maxiLen = 0;
        Map<Character , Integer> mpp = new HashMap<>();
        int l = 0;
        int r = 0;
        while(r < n){
            char ch = s.charAt(r);
            mpp.put(ch , mpp.getOrDefault(ch , 0)+1);
            while(mpp.size() > k){
                char chL = s.charAt(l);
                mpp.put(chL , mpp.get(chL) - 1);

                if(mpp.get(chL) == 0){
                    mpp.remove(chL);
                }
                l++;
            }
            if(mpp.size() <= k){
                maxiLen = Math.max(maxiLen , r-l+1);
            }
            r++;
        }
        return maxiLen;
    }
